================================================== basic
print("my error"!{})
--------------------------------------------------
{
    "msg": my error,
    "sources": [
    ],
    "stack": [
    ],
}
================================================== context
print("my error"!{
    "a": 1,
    "b": 2,
})
--------------------------------------------------
{
    "a": 1,
    "b": 2,
    "msg": my error,
    "sources": [
    ],
    "stack": [
    ],
}
================================================== one_source
err1 := "error one"!{}

print("my error"!(err1){})
--------------------------------------------------
{
    "msg": my error,
    "sources": [
        {
            "msg": error one,
            "sources": [
            ],
            "stack": [
            ],
        },
    ],
    "stack": [
    ],
}
================================================== two_sources
err1 := "error one"!{}
err2 := "error two"!{}

print("my error"!(err1, err2){})
--------------------------------------------------
{
    "msg": my error,
    "sources": [
        {
            "msg": error one,
            "sources": [
            ],
            "stack": [
            ],
        },
        {
            "msg": error two,
            "sources": [
            ],
            "stack": [
            ],
        },
    ],
    "stack": [
    ],
}
================================================== two_sources_and_ctx
err1 := "error one"!{}
err2 := "error two"!{}

print("my error"!(err1, err2){
    "a": 1,
    "b": 2,
})
--------------------------------------------------
{
    "a": 1,
    "b": 2,
    "msg": my error,
    "sources": [
        {
            "msg": error one,
            "sources": [
            ],
            "stack": [
            ],
        },
        {
            "msg": error two,
            "sources": [
            ],
            "stack": [
            ],
        },
    ],
    "stack": [
    ],
}
