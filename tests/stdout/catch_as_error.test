================================================== runtime_error
fn f() {
    throw "my error"
}

[_, err] := ?? f()
if err == null {
    print("ok")
} else {
    print($"error: ${err.msg}")
}
--------------------------------------------------
error: my error
================================================== no_runtime_error
fn f() {
}

[_, err] := ?? f()
if err == null {
    print("ok")
} else {
    print($"error: ${err.msg}")
}
--------------------------------------------------
ok
================================================== two_level_exception
fn g() {
    f()
}

fn f() {
    throw "my error"
}

[_, err] := ?? g()
if err == null {
    print("ok")
} else {
    print($"error: ${err.msg}")
}
--------------------------------------------------
error: my error
================================================== throw_error_object_manual
fn f() {
    throw "my error"!{
        "a": 1,
        "b": 2,
    }
}

[_, err] := ?? f()
print(err)
--------------------------------------------------
{
    "a": 1,
    "b": 2,
    "msg": my error,
}
================================================== throw_error_object_literal
fn f() {
    throw {
        "a": 1,
        "b": 2,
        "msg": "my error",
    }
}

[_, err] := ?? f()
print(err)
--------------------------------------------------
{
    "a": 1,
    "b": 2,
    "msg": my error,
}
==================================================
